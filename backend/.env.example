# CyberRAT v2 — Environment Variables Example
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# Database (SQLite for dev; change to PostgreSQL URL for production)
DATABASE_URL=sqlite:///cyberrat.db

# Frontend address (used in password-reset links and CORS in production)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Key for encrypting stored assessment answers (64 hex characters).
# Optional: if empty, a key is derived from SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=

# Default account passwords (optional; demo defaults are in config.py)
# SEED_ADMIN_PASSWORD=
# SEED_ANALYST_PASSWORD=

# Server port
PORT=5000

# ── Email / OTP ──────────────────────────────────────────────────────
# MAIL_DEBUG_MODE=true  → OTP shown on screen (no email sent)
# MAIL_DEBUG_MODE=false → OTP sent by email (set SMTP settings below)
MAIL_DEBUG_MODE=false

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=your-gmail@gmail.com

