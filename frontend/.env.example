# CyberRAT v2 — Frontend Environment Variables
#
# IMPORTANT: Change this to your backend server's IP address
# Example: If backend runs on 192.168.56.1 port 5000, set:
#   REACT_APP_API_URL=http://192.168.56.1:5000
#
# After changing this file, RESTART npm start (Ctrl+C then npm start again)

REACT_APP_API_URL=http://localhost:5000
